# Copy this file to .env and fill in your Sanity project.
# Leave PUBLIC_SANITY_PROJECT_ID empty to run on the built-in sample content.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Only needed for `npm run seed` (loads the sample projects into Sanity).
# Create at sanity.io/manage → your project → API → Tokens, permission: Editor.
SANITY_API_WRITE_TOKEN=
