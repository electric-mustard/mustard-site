---
// SiteHeader — v2.3 — Made by Electric Mustard
// Fixed header: logo top left (always links home); top right is the EN / NO
// language links and a mail icon on the home page, a close button on project
// pages. System block: no client fields of its own (the email address comes
// from Site settings).
import { localePath, otherLang, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  showClose?: boolean;
  /** Email address for the mail icon (home page). */
  mailTo?: string;
  /** This page in the other language. */
  altUrl: string;
  /** Starting colour: dark text on light pages, light text on dark pages. */
  theme?: 'light' | 'dark';
}
const { lang, showClose = false, mailTo, altUrl, theme = 'dark' } = Astro.props;
const other = otherLang(lang);
const home = localePath(lang, '/');
---

<header class="site-header" data-theme={theme} transition:name="site-header">
  <a href={home} class="site-header__logo" aria-label={t(lang, 'home')} data-nav-back>
    <svg viewBox="0 0 51 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path
        d="M49.3848 12.6197C47.0297 10.5264 45.2471 9.74135 42.6304 9.90489C38.7054 10.232 35.6798 13.65 32.8996 16.185C30.7899 18.1148 28.5493 20.4044 25.6219 21.0095C22.8253 21.5819 20.274 19.5703 18.9166 17.2971C16.7906 13.5356 15.9401 8.71102 15.1224 4.45889L6.68357 13.8626L1.38477 9.03811"
        stroke="currentColor"
        stroke-width="4.11429"
        stroke-miterlimit="10"></path>
    </svg>
  </a>

  {
    showClose ? (
      <a href={home} class="site-header__close" aria-label={t(lang, 'closeProject')} data-nav-back>
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 19H5v-2h2v2Zm12 0h-2v-2h2v2ZM9 15v2H7v-2h2Zm8 2h-2v-2h2v2Zm-6-2H9v-2h2v2Zm4 0h-2v-2h2v2Zm-2-2h-2v-2h2v2Zm-2-2H9V9h2v2Zm4 0h-2V9h2v2ZM9 9H7V7h2v2Zm8 0h-2V7h2v2ZM7 7H5V5h2v2Zm12 0h-2V5h2v2Z" />
        </svg>
      </a>
    ) : (
      <div class="site-header__right">
        <nav class="site-header__lang notranslate" translate="no" aria-label={t(lang, 'language')}>
          {lang === 'en' ? <span aria-current="true">EN</span> : <a href={altUrl} data-set-lang="en" hreflang="en">EN</a>}
          <span class="site-header__lang-sep" aria-hidden="true">/</span>
          {lang === 'no' ? <span aria-current="true">NO</span> : <a href={altUrl} data-set-lang="no" hreflang={other}>NO</a>}
        </nav>
        {mailTo && (
          <a href={`mailto:${mailTo}`} class="site-header__mail" aria-label={t(lang, 'emailUs')}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 20H4v-2h16v2ZM4 18H2V6h2v12Zm18 0h-2V6h2v12Zm-8-4h-4v-2h4v2Zm-4-2H8v-2h2v2Zm6 0h-2v-2h2v2Zm-8-2H6V8h2v2Zm10 0h-2V8h2v2Zm2-4H4V4h16v2Z" />
            </svg>
          </a>
        )}
      </div>
    )
  }
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    padding-inline: var(--edge);
    color: var(--color-fg);
    --header-line: var(--color-line);
    pointer-events: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  /* Flips to dark when a light or accent block sits under the header (see script). */
  .site-header[data-theme='light'] {
    color: var(--color-light-fg);
    --header-line: var(--color-light-line);
  }

  .site-header__logo,
  .site-header__close,
  .site-header__mail {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
  }

  .site-header__logo {
    width: var(--logo-width);
  }
  .site-header__logo svg {
    width: 100%;
    height: auto;
  }

  .site-header__close {
    width: 2.75rem;
    height: 2.75rem;
    opacity: var(--icon-dim);
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .site-header__close svg {
    width: var(--icon-size);
    height: var(--icon-size);
  }
  .site-header__close:hover {
    opacity: 1;
  }

  .site-header__right {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-header__mail {
    width: 2.75rem;
    height: 2.75rem;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .site-header__mail svg {
    width: var(--icon-size);
    height: var(--icon-size);
  }
  .site-header__mail:hover {
    transform: scale(1.08);
  }

  .site-header__lang {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }
  .site-header__lang a,
  .site-header__lang span[aria-current] {
    padding: var(--space-2) 0;
    color: inherit;
    text-decoration: none;
  }
  .site-header__lang a {
    opacity: 0.45;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .site-header__lang a:hover {
    opacity: 1;
  }
  .site-header__lang-sep {
    opacity: 0.45;
  }
</style>

<script>
  // Watches for light / accent blocks under the header and flips its colour.
  let observer: IntersectionObserver | null = null;

  function init() {
    observer?.disconnect();
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;
    const under = new Set<Element>();
    const band = Math.max(1, window.innerHeight - header.offsetHeight);
    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? under.add(e.target) : under.delete(e.target)));
        header.dataset.theme = under.size ? 'light' : 'dark';
      },
      { rootMargin: `0px 0px -${band}px 0px`, threshold: 0 }
    );
    document.querySelectorAll('.bg-light, .bg-accent').forEach((el) => observer?.observe(el));
  }

  let resizeTimer = 0;
  document.addEventListener('astro:page-load', init);
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(init, 150);
  });
</script>
