---
// ProjectNav — v2.3 — Made by Electric Mustard
// The way out of a project: next project (big), or close and go home.
// Sits on the outer edge, in line with the images. System block: content
// comes from the project order, so no Sanity schema.
import type { Project } from '../lib/types';
import { isLang, localePath, t, type Lang } from '../lib/i18n';

interface Props {
  next?: Project;
  /** Page language: links and labels follow it. */
  lang?: Lang;
}

const { next, lang: langProp } = Astro.props;
const lang: Lang = isLang(langProp) ? langProp : 'en';
---

<nav class="project-nav block pad-lg bg-light" aria-label={t(lang, 'projects')}>
  <div class="container project-nav__inner" data-reveal-group>
    {
      next && (
        <a href={localePath(lang, `/work/${next.slug}/`)} class="project-nav__next">
          <span class="eyebrow" data-reveal>{t(lang, 'nextProject')}</span>
          <span class="project-nav__title" data-reveal>{next.title}</span>
          <span class="project-nav__thumb" data-reveal="image">
            <img
              src={next.cover.src}
              srcset={next.cover.srcset}
              sizes="12rem"
              width={next.cover.width}
              height={next.cover.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </span>
        </a>
      )
    }
    <a href={localePath(lang, '/')} class="project-nav__close" data-nav-back data-reveal="block">
      <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M7 19H5v-2h2v2Zm12 0h-2v-2h2v2ZM9 15v2H7v-2h2Zm8 2h-2v-2h2v2Zm-6-2H9v-2h2v2Zm4 0h-2v-2h2v2Zm-2-2h-2v-2h2v2Zm-2-2H9V9h2v2Zm4 0h-2V9h2v2ZM9 9H7V7h2v2Zm8 0h-2V7h2v2ZM7 7H5V5h2v2Zm12 0h-2V5h2v2Z"
        ></path>
      </svg>
      <span>{t(lang, 'close')}</span>
    </a>
  </div>
</nav>

<style>
  .project-nav {
    border-top: 1px solid var(--block-line);
  }

  .project-nav__inner {
    display: grid;
    gap: var(--space-7);
  }

  .project-nav__next {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'eyebrow thumb'
      'title thumb';
    align-items: center;
    column-gap: var(--space-6);
    row-gap: var(--space-3);
    text-decoration: none;
  }
  .project-nav__next .eyebrow {
    grid-area: eyebrow;
  }

  .project-nav__title {
    grid-area: title;
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .project-nav__thumb {
    grid-area: thumb;
    width: 6rem;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .project-nav__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-nav__close {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: inherit;
    text-decoration: none;
    font-size: var(--text-sm);
    opacity: var(--icon-dim);
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .project-nav__close svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .project-nav__close:hover {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .project-nav__thumb {
      width: 10rem;
    }
  }
</style>
