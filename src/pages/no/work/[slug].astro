---
// Prosjektside (Norwegian) — v1.0 — Made by Electric Mustard
import ProjectPage from '../../../templates/ProjectPage.astro';
import { getProjects } from '../../../lib/sanity';
import type { Project } from '../../../lib/types';

export async function getStaticPaths() {
  const projects = await getProjects('no');
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<ProjectPage lang="no" project={project} />
